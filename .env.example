# Keep real credentials only in an ignored .env.local file when live Codex is enabled.
EPM_PORT=4317
EPM_HOST=127.0.0.1
EPM_AGENT_GATEWAY=mock
# Live mode remains off unless both safe flags below are explicitly enabled.
# EPM_AGENT_GATEWAY=codex-app-server
# EPM_ENABLE_CODEX=1
# Existing `codex login` state is reused when no API key is configured.
# Optional OPENAI_API_KEY stays only in ignored .env.local and uses an isolated credential store.
